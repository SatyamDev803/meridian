# Delta Exchange India testnet (demo account) keys: testnet.delta.exchange, then API keys.
# Give the key trading permission. Leave IP whitelisting off if you deploy to Render.
DELTA_API_KEY=
DELTA_API_SECRET=

# Defaults already point at the India testnet; override only if Delta changes them.
# DELTA_REST_URL=https://cdn-ind.testnet.deltaex.org
# DELTA_WS_PRIVATE_URL=wss://socket-ind.testnet.deltaex.org
# DELTA_WS_PUBLIC_URL=wss://socket-ind-pub.testnet.deltaex.org
# SYMBOL=BTCUSD
# LEVERAGE=5

# Strategy defaults (all editable live from the dashboard).
# SPREAD_BPS=8
# SKEW_BPS=10
# ORDER_SIZE=10
# MAX_POSITION=50
# MAX_SESSION_LOSS=50

# Set this when the dashboard is public; the dashboard asks for it under Settings, Access.
CONTROL_API_KEY=
CHAOS_ENABLED=true
AUTO_START=false
DATABASE_URL=sqlite:///./meridian.db
